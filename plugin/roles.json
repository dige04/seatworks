{
  "providerPrefix": "sw2-",
  "attention": {
    "brain": "both",
    "sensor": "jev"
  },
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, opens lanes, answers Leads and decides what is not the Human's to decide",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "high"
      },
      "can": [
        "supervise"
      ],
      "tools": "supervisor",
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [
        "CONTEXT.md",
        "notebook.md",
        "pre-mortem/",
        "architecture-premise-audit/"
      ]
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns a lane: splits it into tasks, starts Peers, accepts and integrates; stays on after it closes until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "medium"
      },
      "can": [
        "lead",
        "watched"
      ],
      "tools": "lead",
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [
        "plans/",
        "council/",
        "ultra-review/",
        "repo-refresh/"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does one task for its Lead, finding where the change goes, and hands it back; stays until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "medium"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Read-only Peer that reviews a task branch with clean context",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5",
        "thinking": "medium"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "second-reviewer",
      "label": "Second reviewer",
      "description": "A Reviewer on another model, so two review lenses are not one model read twice",
      "like": "reviewer",
      "defaults": {
        "harness": "claude",
        "model": "claude-sonnet-5",
        "thinking": "medium"
      }
    },
    {
      "role": "watcher",
      "label": "Watcher",
      "description": "Judges what the watch's eye read of a Lead or a Peer against its patterns; it cannot touch the work",
      "follows": "peer",
      "can": [
        "judge"
      ],
      "tools": "watcher",
      "prompt": "prompts/WATCHER.md",
      "skills": null,
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": []
    }
  ]
}
