{
  "startup": {
    "quiet": true,
    "checkUpdate": false
  },
  "disabledProviders": [
    "claude",
    "claude-plugins",
    "claude-md",
    "codex",
    "gemini",
    "opencode",
    "cursor",
    "windsurf",
    "vscode",
    "cline",
    "github",
    "agents",
    "agent-plugins",
    "mcp-json",
    "omp-plugins"
  ],
  "mcp": {
    "enableProjectConfig": false
  },
  "skills": {
    "enableClaudeUser": false,
    "enableClaudeProject": false,
    "enableCodexUser": false,
    "enableAgentsUser": false,
    "enableAgentsProject": false,
    "enablePiProject": false
  },
  "memory": {
    "backend": "off"
  },
  "autolearn": {
    "enabled": false
  },
  "advisor": {
    "enabled": false
  },
  "ask": {
    "enabled": false
  },
  "github": {
    "enabled": false
  },
  "task": {
    "maxRecursionDepth": 0
  },
  "eval": {
    "py": false,
    "js": false
  },
  "tools": {
    "approval": {
      "task": "deny",
      "eval": "deny",
      "learn": "deny",
      "manage_skill": "deny",
      "memory_edit": "deny",
      "retain": "deny"
    },
    "xdev": false
  },
  "bash": {
    "autoBackground": {
      "enabled": false
    },
    "patterns": [
      {
        "match": "git push",
        "approval": "deny"
      },
      {
        "match": "git push *",
        "approval": "deny"
      },
      {
        "match": "git -C * push",
        "approval": "deny"
      },
      {
        "match": "git -C * push *",
        "approval": "deny"
      },
      {
        "match": "git pull",
        "approval": "deny"
      },
      {
        "match": "git pull *",
        "approval": "deny"
      },
      {
        "match": "git -C * pull",
        "approval": "deny"
      },
      {
        "match": "git -C * pull *",
        "approval": "deny"
      },
      {
        "match": "git checkout",
        "approval": "deny"
      },
      {
        "match": "git checkout *",
        "approval": "deny"
      },
      {
        "match": "git -C * checkout",
        "approval": "deny"
      },
      {
        "match": "git -C * checkout *",
        "approval": "deny"
      },
      {
        "match": "git switch",
        "approval": "deny"
      },
      {
        "match": "git switch *",
        "approval": "deny"
      },
      {
        "match": "git -C * switch",
        "approval": "deny"
      },
      {
        "match": "git -C * switch *",
        "approval": "deny"
      },
      {
        "match": "git update-ref",
        "approval": "deny"
      },
      {
        "match": "git update-ref *",
        "approval": "deny"
      },
      {
        "match": "git -C * update-ref",
        "approval": "deny"
      },
      {
        "match": "git -C * update-ref *",
        "approval": "deny"
      },
      {
        "match": "git stash",
        "approval": "deny"
      },
      {
        "match": "git stash *",
        "approval": "deny"
      },
      {
        "match": "git -C * stash",
        "approval": "deny"
      },
      {
        "match": "git -C * stash *",
        "approval": "deny"
      },
      {
        "match": "git branch -f*",
        "approval": "deny"
      },
      {
        "match": "git -C * branch -f*",
        "approval": "deny"
      },
      {
        "match": "git branch -D*",
        "approval": "deny"
      },
      {
        "match": "git -C * branch -D*",
        "approval": "deny"
      },
      {
        "match": "git branch --force*",
        "approval": "deny"
      },
      {
        "match": "git -C * branch --force*",
        "approval": "deny"
      }
    ]
  },
  "launch": {
    "enabled": false
  },
  "ttsr": {
    "builtinRules": false
  }
}
