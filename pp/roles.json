{
  "providerPrefix": "sw2-",
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, opens lanes, answers Leads and decides what is not the Human's to decide",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "supervise"
      ],
      "tools": "supervisor",
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [
        "CONTEXT.md",
        "notebook.md",
        "pre-mortem/",
        "architecture-premise-audit/"
      ]
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns a lane: splits it into tasks, starts Peers, accepts and integrates; stays on after it closes until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "lead",
        "watched"
      ],
      "tools": "lead",
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [
        "plans/",
        "council/",
        "ultra-review/",
        "repo-refresh/"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Does one task for its Lead, finding where the change goes, and hands it back; stays until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "medium"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "peer-flash",
      "label": "Peer (Flash)",
      "description": "A Peer on Gemini 3.8 Flash for well-bounded work with a settled contract: fast and cheap, not for open premises or risky areas",
      "like": "peer",
      "defaults": {
        "harness": "omp",
        "model": "google-antigravity/gemini-3.8-flash",
        "thinking": "high"
      }
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Peer that reviews a commit with clean context, in a copy of its own that goes with the review",
      "defaults": {
        "harness": "codex",
        "model": "gpt-6-sol",
        "thinking": "high"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "second-reviewer",
      "label": "Second reviewer",
      "description": "A Reviewer on another model, so two review lenses are not one model read twice",
      "like": "reviewer",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "xhigh"
      }
    },
    {
      "role": "architect",
      "label": "Architect",
      "description": "A Peer the Lead asks about a hard design decision: it weighs the designs the code allows, with clean context, and changes nothing",
      "like": "reviewer",
      "prompt": "prompts/ARCHITECT.md",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      }
    },
    {
      "role": "auditor",
      "label": "Auditor",
      "description": "A Peer that audits a lane's proof: whether its tests and end-to-end checks prove what they claim, by running them",
      "like": "reviewer",
      "prompt": "prompts/AUDITOR.md",
      "defaults": {
        "harness": "omp",
        "model": "google-antigravity/gemini-3.8-flash",
        "thinking": "high"
      }
    },
    {
      "role": "watcher",
      "label": "Watcher",
      "description": "Judges what the watch's eye read of a Lead or a Peer against its patterns; it cannot touch the work",
      "can": [
        "judge"
      ],
      "tools": "watcher",
      "prompt": "prompts/WATCHER.md",
      "skills": null,
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [],
      "defaults": {
        "harness": "omp",
        "model": "google-antigravity/gemini-3.8-flash",
        "thinking": "high"
      }
    }
  ]
}
