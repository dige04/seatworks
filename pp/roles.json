{
  "providerPrefix": "sw2-",
  "attention": {
    "tickSeconds": 30,
    "leadIdleMinutes": 12,
    "askRemindMinutes": 15,
    "maxReminders": 2,
    "judge": "jev"
  },
  "roles": [
    {
      "role": "supervisor",
      "label": "Supervisor",
      "description": "Works with the Human, decides everything short of the concept, opens lanes and answers Leads",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "supervise"
      ],
      "tools": "supervisor",
      "prompt": "prompts/SUPERVISOR.md",
      "skills": "supervisor",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [
        "CONTEXT.md",
        "notebook.md",
        "pre-mortem/",
        "architecture-premise-audit/"
      ]
    },
    {
      "role": "lead",
      "label": "Lead",
      "description": "Owns a lane: splits it into tasks, starts Peers, accepts and integrates; stays on after it closes until released",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "medium"
      },
      "can": [
        "lead",
        "watched"
      ],
      "tools": "lead",
      "prompt": "prompts/LEAD.md",
      "skills": "lead",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "supervisor"
      ],
      "writes": [
        "plans/",
        "council/",
        "ultra-review/",
        "repo-refresh/"
      ]
    },
    {
      "role": "peer",
      "label": "Peer",
      "description": "Default Peer on Claude Opus 5.5: most tasks, inside owned paths, with acceptance a focused check can show.",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "medium"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "ocr",
        "paseo",
        "seat",
        "seats",
        "supervisor"
      ]
    },
    {
      "role": "peer-deep",
      "label": "Deep Peer",
      "description": "Peer on Claude Opus 5.5 at high effort for cross-cutting or terminal-heavy work, risky areas (auth, money, migrations, concurrency), or a task peer handed back wrong twice.",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "high"
      },
      "can": [
        "work",
        "write",
        "watched"
      ],
      "tools": "peer",
      "prompt": "prompts/PEER.md",
      "skills": "peer",
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "ocr",
        "paseo",
        "seat",
        "seats",
        "supervisor"
      ]
    },
    {
      "role": "reviewer",
      "label": "Reviewer",
      "description": "Default reviewer on GPT-6 Sol, a different vendor from the Lead and the Peers: every review of a task or a lane.",
      "defaults": {
        "harness": "codex",
        "model": "gpt-6-sol",
        "thinking": "high"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "reviewer-claude",
      "label": "Second Reviewer",
      "description": "Second lens on Claude Opus 5.5: the other half of a council, or a second read before a risky landing. Not for routine reviews.",
      "defaults": {
        "harness": "claude",
        "model": "claude-opus-5-5",
        "thinking": "xhigh"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER.md",
      "skills": null,
      "extraSkills": [
        "peer:test-proof-debt-audit",
        "peer:security-check"
      ],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "reviewer-ocr",
      "label": "Coverage Reviewer",
      "description": "Coverage lane on GPT-6 Luna with OCR delegation: accounts for every reviewable file of a lane with evidence. Only for the final review of a lane before it is reported ready, beside the two semantic reviewers.",
      "defaults": {
        "harness": "codex",
        "model": "gpt-6-luna",
        "thinking": "max"
      },
      "can": [
        "work",
        "review"
      ],
      "tools": "reviewer",
      "concern": "review",
      "prompt": "prompts/REVIEWER-OCR.md",
      "skills": null,
      "extraSkills": [],
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [
        "paseo",
        "supervisor",
        "seat",
        "seats"
      ]
    },
    {
      "role": "watcher",
      "label": "Watcher",
      "description": "Answers the watch's questions about one moment of the work at a time, from what the desk read then; it cannot touch the work",
      "can": [
        "judge"
      ],
      "tools": "watcher",
      "prompt": "prompts/WATCHER.md",
      "skills": null,
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": [],
      "defaults": {
        "harness": "codex",
        "model": "gpt-6-luna",
        "thinking": "medium"
      }
    },
    {
      "role": "pager",
      "label": "Pager",
      "description": "Carries a page to the Human: says back the lines the desk gives it, and Paseo pushes them to their phone",
      "defaults": {
        "harness": "claude",
        "model": "claude-haiku-4-5",
        "thinking": "low"
      },
      "can": [
        "page"
      ],
      "prompt": "prompts/PAGER.md",
      "skills": null,
      "paseoTools": {
        "enabled": false
      },
      "hidesWords": [],
      "writes": []
    }
  ]
}
